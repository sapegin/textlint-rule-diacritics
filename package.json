{
	"name": "textlint-rule-diacritics",
	"version": "0.0.0-development",
	"description": "Textlint rule to check correct usage of diacritics",
	"author": {
		"name": "Artem Sapegin",
		"url": "https://sapegin.me"
	},
	"homepage": "https://github.com/sapegin/textlint-rule-diacritics",
	"repository": "sapegin/textlint-rule-diacritics",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"type": "module",
	"exports": "./out/index.js",
	"files": [
		"out",
		"words.json"
	],
	"scripts": {
		"try": "textlint --rule ./index.js Readme.md",
		"pretest": "npm run lint && npm run typecheck",
		"test": "npm run test:vitest",
		"posttest": "npm run format",
		"lint": "eslint . --cache --fix",
		"typecheck": "tsc --noEmit",
		"test:vitest": "vitest run",
		"test:watch": "vitest",
		"build": "tsc",
		"format": "prettier --write \"**/*.{js,cjs,mjc,ts,tsx,md,json}\"",
		"prepublish": "npm run build",
		"prepare": "husky"
	},
	"keywords": [
		"textlintrule",
		"textlint",
		"rule",
		"misspelling",
		"proofreading",
		"diacritic",
		"diacritics",
		"diacritical",
		"mark",
		"point",
		"sign"
	],
	"devDependencies": {
		"@textlint/ast-node-types": "^15.2.2",
		"@textlint/types": "^15.2.2",
		"@types/node": "^24.6.2",
		"eslint": "^9.36.0",
		"eslint-config-tamia": "^9.3.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.3",
		"prettier": "^3.6.2",
		"textlint-tester": "^15.2.2",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"match-casing": "^2.0.1",
		"strip-json-comments": "^5.0.3"
	},
	"peerDependencies": {
		"textlint": ">=13"
	},
	"lint-staged": {
		"*.{js,cjs,mjc,ts,tsx,md,json}": "prettier --write",
		"*.{js,cjs,mjs,ts,tsx}": "eslint --fix --cache"
	}
}
