{
	"name": "textlint-rule-diacritics",
	"version": "0.0.0-development",
	"description": "Textlint rule to check correct usage of diacritics",
	"author": {
		"name": "Artem Sapegin",
		"url": "https://sapegin.me"
	},
	"homepage": "https://github.com/sapegin/textlint-rule-diacritics",
	"repository": "sapegin/textlint-rule-diacritics",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"main": "index.js",
	"files": [
		"index.js",
		"words.json"
	],
	"scripts": {
		"try": "textlint --rule ./index.js Readme.md",
		"pretest": "npm run lint",
		"test": "npm run test:vitest",
		"posttest": "npm run format",
		"lint": "eslint . --cache --fix",
		"test:vitest": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write \"**/*.{js,md}\""
	},
	"keywords": [
		"textlintrule",
		"textlint",
		"rule",
		"misspelling",
		"proofreading",
		"diacritic",
		"diacritics",
		"diacritical",
		"mark",
		"point",
		"sign"
	],
	"devDependencies": {
		"eslint": "^8.0.0",
		"eslint-config-tamia": "^8.1.3",
		"prettier": "^3.3.1",
		"textlint-tester": "^14.0.4",
		"vitest": "^1.6.0"
	},
	"dependencies": {
		"match-casing": "^2.0.1",
		"strip-json-comments": "^5.0.1"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.{js,md}": [
			"prettier --write",
			"git add"
		],
		"*.js": [
			"eslint --fix",
			"git add"
		]
	}
}
