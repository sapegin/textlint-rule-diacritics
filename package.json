{
	"name": "textlint-rule-diacritics",
	"version": "0.0.0-development",
	"description": "Textlint rule to check correct usage of diacritics",
	"author": {
		"name": "Artem Sapegin",
		"url": "https://sapegin.me"
	},
	"homepage": "https://github.com/sapegin/textlint-rule-diacritics",
	"repository": "sapegin/textlint-rule-diacritics",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"main": "out/index.js",
	"files": [
		"out",
		"words.json"
	],
	"scripts": {
		"try": "textlint --rule ./index.js Readme.md",
		"pretest": "npm run lint",
		"test": "npm run test:vitest",
		"posttest": "npm run format",
		"lint": "eslint . --cache --fix",
		"test:vitest": "vitest run",
		"test:watch": "vitest",
		"build": "tsc",
		"format": "prettier --write \"**/*.{js,md,json}\"",
		"prepare": "husky"
	},
	"keywords": [
		"textlintrule",
		"textlint",
		"rule",
		"misspelling",
		"proofreading",
		"diacritic",
		"diacritics",
		"diacritical",
		"mark",
		"point",
		"sign"
	],
	"devDependencies": {
		"@textlint/ast-node-types": "^14.0.4",
		"@textlint/types": "^14.0.4",
		"@typescript-eslint/eslint-plugin": "^7.12.0",
		"@typescript-eslint/parser": "^7.12.0",
		"eslint": "^8.0.0",
		"eslint-config-tamia": "^8.1.3",
		"husky": "^9.0.11",
		"lint-staged": "^15.2.5",
		"prettier": "^3.3.1",
		"textlint-tester": "^14.0.4",
		"typescript": "^5.4.5",
		"vitest": "^1.6.0"
	},
	"dependencies": {
		"match-casing": "^2.0.1",
		"strip-json-comments": "^5.0.1"
	},
	"lint-staged": {
		"*.{js,md,json}": [
			"prettier --write"
		],
		"*.js": [
			"eslint --fix"
		]
	}
}
